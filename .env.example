TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Recommended: Helius free tier
# SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_KEY

# Free key from developers.jup.ag: 1 request/s instead of 0.5. The same key can serve the Par site too.
JUPITER_API_KEY=
BIRDEYE_API_KEY=

DATABASE_PATH=./data/bot.db

# The pump.fun coin. Pings send only while the wallet still holds it.
# Leave blank until the mint exists. Lookups still work.
TOKEN_MINT=
# 0 means any amount. Set 1 to require at least one whole token.
HOLDER_MIN_TOKENS=0

# Optional: a public Telegram channel for a short morning-brief teaser (@channelname or -100…).
# Add the bot to the channel as an admin first. Leave blank for no channel post.
BRIEF_CHANNEL_ID=

BIG_MOVE_THRESHOLD_PCT=5
BIG_MOVE_WINDOW_MINUTES=60
ALERT_CHECK_INTERVAL_CRON=*/5 * * * *
# Fair, bell, don't-buy, and bag checks. Quotes are cached.
DESK_CHECK_CRON=* * * * *
