TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Recommended: Helius free tier
# SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_KEY

# Leave this empty for the bot. Jupiter's free plan allows 1 request every 2 seconds per organisation,
# the same pace as keyless (which is counted per IP). The Par site uses the key; if the bot used the same
# key, the two would share one limit instead of having one each.
JUPITER_API_KEY=
BIRDEYE_API_KEY=

DATABASE_PATH=./data/bot.db

# The pump.fun coin. Its official address and the holder minimum (250,000 $PAR) live in src/config/par.ts.
# Leave both blank: set them here only as an emergency override. Pings send only while the wallet still holds enough.
TOKEN_MINT=
HOLDER_MIN_TOKENS=

# Optional: a public Telegram channel for a short morning-brief teaser and the Friday ranking (@channelname or -100…).
# Add the bot to the channel as an admin first. Leave blank for no channel post.
BRIEF_CHANNEL_ID=

BIG_MOVE_THRESHOLD_PCT=5
BIG_MOVE_WINDOW_MINUTES=60
ALERT_CHECK_INTERVAL_CRON=*/5 * * * *
# Fair, bell, don't-buy, and bag checks. Quotes are cached.
DESK_CHECK_CRON=* * * * *
# Pause alerts and SEC filing texts (/events). Filings come from the site's /api/events.
EVENTS_CHECK_CRON=*/3 * * * *
# Optional: the same secret as SHARE_BUYS_SECRET in Netlify (64 hex characters from: openssl rand -hex 32). The bot then
# sends its $1,000 buy quotes to the Par site after each round, so the site shows them at once. Empty means off.
SHARE_BUYS_SECRET=
# Optional: your own Telegram ID (send /myid to the bot). Health alerts, backup failures, restarts and the server
# watchdog's messages go there. Empty means they only go to the log.
ALERT_CHAT_ID=
