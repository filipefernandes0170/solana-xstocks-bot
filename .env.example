TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Recommended: Helius free tier
# SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_KEY

JUPITER_API_KEY=
BIRDEYE_API_KEY=

DATABASE_PATH=./data/bot.db

# The pump.fun coin. Pings send only while the wallet still holds it.
# Leave blank until the mint exists. Lookups still work.
TOKEN_MINT=
# 0 means any amount. Set 1 to require at least one whole token.
HOLDER_MIN_TOKENS=0

BIG_MOVE_THRESHOLD_PCT=5
BIG_MOVE_WINDOW_MINUTES=60
ALERT_CHECK_INTERVAL_CRON=*/5 * * * *
# Fair, bell, don't-buy, and bag checks. Quotes are cached.
DESK_CHECK_CRON=* * * * *
