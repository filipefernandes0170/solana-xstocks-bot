    "dev:windows": "node --use-system-ca node_modules/vite/bin/vite.js dev --port 3000"
  },
  "dependencies": {
    "@netlify/blobs": "11.1.4",
    "@tanstack/react-router": "1.170.45",
    "@tanstack/react-start": "1.169.3",
    "lucide-react": "1.58.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "2.15.4"
  },
  "devDependencies": {
    "@netlify/vite-plugin-tanstack-start": "1.3.19",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  }
}
